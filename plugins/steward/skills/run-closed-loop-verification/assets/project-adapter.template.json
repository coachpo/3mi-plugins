{
  "schemaVersion": 1,
  "projectId": "replace-with-project-id",
  "projectRoot": ".",
  "campaignRoot": ".closed-loop-verification",
  "coverageMode": "narrow",
  "source": {
    "provider": "manifest",
    "manifest": "verification-source.json",
    "excludes": [
      ".closed-loop-verification"
    ]
  },
  "localOnly": {
    "enabled": true,
    "allowedExternalCapabilities": []
  },
  "traceability": {
