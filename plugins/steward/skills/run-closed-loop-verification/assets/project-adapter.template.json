{
  "schemaVersion": 2,
  "source": {
    "provider": "git",
    "excludes": [
      ".steward"
    ]
  },
  "goalContract": {
    "path": ".steward/goal.txt",
    "contractVersion": 1,
    "sha256": "sha256:replace-with-canonical-goal-contract-digest"
  },
  "cases": [
    {
      "id": "acceptance",
      "required": true,
      "platform": "any",
      "coversCriteria": [
        "C1"
      ],
      "argv": [
        "replace-with-project-native-runner"
      ],
      "cwd": ".",
      "timeoutSeconds": 60,
      "evidence": {
        "requiredFiles": [],
        "nonEmptyFiles": []
      }
    }
  ]
}
