{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "steward.architecture-profile-selection-evidence.v1",
  "title": "Steward architecture profile selection evidence v1",
  "description": "Portable input for architecture_profiles.py select. The bundled validator additionally enforces normalized safe scopes, sorted unique signals, sorted capability keys, bounded JSON bytes, and exact JSON field sets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "components"],
  "properties": {
    "schemaVersion": {"const": 1},
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/component"}
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:-]*$"
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "signals", "capabilities"],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:\\.|(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!\\s)(?!.*\\s$)[^/\\u0000-\\u001F\\u0085\\u2028\\u2029]+(?:/[^/\\u0000-\\u001F\\u0085\\u2028\\u2029]+)*)$",
          "description": "Normalized project-relative POSIX path; a single dot means the repository root."
        },
        "signals": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/token"}
        },
        "capabilities": {
          "type": "object",
          "maxProperties": 128,
          "propertyNames": {"$ref": "#/$defs/token"},
          "additionalProperties": {
            "enum": ["present", "absent", "unknown"]
          }
        }
      }
    }
  }
}
