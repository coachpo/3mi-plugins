{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "steward.ci-plan.v1",
  "title": "Steward CI Full Plan v1",
  "description": "Deterministic exact partition emitted by verification_pipeline.build_ci_plan. The shared validator additionally checks unique entry IDs, shardIndex <= shardCount, profile/catalog drift, selector assignment, dependency components, complete case coverage without duplicates, and the canonical digest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "projectId",
    "profileSha256",
    "verificationCatalogFingerprint",
    "requiredPlatforms",
    "fullCaseIds",
    "entries",
    "contentDigest"
  ],
  "properties": {
    "schemaId": {"const": "steward.ci-plan"},
    "schemaVersion": {"const": 1},
    "projectId": {"$ref": "#/$defs/id"},
    "profileSha256": {"$ref": "#/$defs/hash"},
    "verificationCatalogFingerprint": {"$ref": "#/$defs/hash"},
    "requiredPlatforms": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/platform"},
      "uniqueItems": true
    },
    "fullCaseIds": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/id"},
      "uniqueItems": true
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    },
    "contentDigest": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?![\\s\\S]*[\\u0000\\u000A\\u000D])(?:[\\s\\S]*\\S)?$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "platform": {
      "enum": ["darwin", "linux", "windows"]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "platform", "shardIndex", "shardCount", "caseIds"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["selector", "platform"]},
        "platform": {"$ref": "#/$defs/platform"},
        "shardIndex": {"type": "integer", "minimum": 1},
        "shardCount": {"type": "integer", "minimum": 1, "maximum": 64},
        "caseIds": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/id"},
          "uniqueItems": true
        }
      }
    }
  }
}
