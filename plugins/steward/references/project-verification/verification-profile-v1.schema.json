{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "steward.verification-profile.v1",
  "title": "Steward Verification Profile v1",
  "description": "Persisted provider-neutral input facts consumed by scripts/verification_pipeline.py; this is not the normalized validate-profile report, which also projects derived adapterCatalogFingerprint and adapterCaseIds fields. The shared loader additionally validates referenced adapter cases, dependency closure, canonical project-relative paths, runtime entries, output exclusions, unique output values, non-nested dynamic output directories, file/dynamic-directory separation, base-adapter separation from dynamic directories, and the canonical digest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "projectId",
    "projectRoot",
    "adapter",
    "runtime",
    "changeDetection",
    "packages",
    "guards",
    "tiers",
    "ci",
    "outputs"
  ],
  "properties": {
    "schemaId": {"const": "steward.verification-profile"},
    "schemaVersion": {"const": 1},
    "projectId": {"$ref": "#/$defs/id"},
    "projectRoot": {"$ref": "#/$defs/projectRootPath"},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pluginRoot", "pythonExecutables"],
      "properties": {
        "pluginRoot": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/projectPath"}
          ]
        },
        "pythonExecutables": {
          "type": "object",
          "additionalProperties": false,
          "required": ["posix", "windows"],
          "properties": {
            "posix": {"$ref": "#/$defs/executable"},
            "windows": {"$ref": "#/$defs/executable"}
          }
        }
      }
    },
    "changeDetection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "baseRef", "sources", "highImpactPaths", "unknownPath"],
      "properties": {
        "provider": {"const": "git"},
        "baseRef": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/nonEmptyString"}
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {"const": "committed"},
            {"const": "staged"},
            {"const": "unstaged"},
            {"const": "untracked"}
          ],
          "items": false
        },
        "highImpactPaths": {
          "type": "array",
          "items": {"$ref": "#/$defs/pathPattern"},
          "uniqueItems": true
        },
        "unknownPath": {"const": "full"}
      }
    },
    "packages": {
      "type": "array",
      "items": {"$ref": "#/$defs/package"}
    },
    "guards": {
      "type": "array",
      "items": {"$ref": "#/$defs/guard"}
    },
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quick", "full"],
      "properties": {
        "quick": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selection"],
          "properties": {"selection": {"const": "impact-plan"}}
        },
        "full": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selection", "ignoreSelector"],
          "properties": {
            "selection": {"const": "all"},
            "ignoreSelector": {"const": true}
          }
        }
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platforms",
        "portablePlatform",
        "posixPlatform",
        "selectorPlatform",
        "selectorCaseIds"
      ],
      "properties": {
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/platform"},
          "contains": {
            "type": "object",
            "required": ["required"],
            "properties": {"required": {"const": true}}
          },
          "minContains": 1
        },
        "portablePlatform": {"$ref": "#/$defs/concretePlatform"},
        "posixPlatform": {"enum": ["darwin", "linux"]},
        "selectorPlatform": {"$ref": "#/$defs/concretePlatform"},
        "selectorCaseIds": {
          "allOf": [
            {"$ref": "#/$defs/idArray"},
            {"minItems": 1}
          ]
        }
      }
    },
    "outputs": {
      "type": "object",
      "description": "The loader requires all nine values to be unique. derivedAdapters, campaigns, and evidenceBundles are mutually non-nested dynamic directories; no file output or base adapter may overlap them.",
      "additionalProperties": false,
      "required": [
        "profile",
        "impactPlan",
        "ciPlan",
        "localEntry",
        "workflow",
        "derivedAdapters",
        "campaigns",
        "evidenceBundles",
        "aggregation"
      ],
      "properties": {
        "profile": {"$ref": "#/$defs/outputPath"},
        "impactPlan": {"$ref": "#/$defs/outputPath"},
        "ciPlan": {"$ref": "#/$defs/outputPath"},
        "localEntry": {"$ref": "#/$defs/outputPath"},
        "workflow": {"$ref": "#/$defs/outputPath"},
        "derivedAdapters": {"$ref": "#/$defs/outputPath"},
        "campaigns": {"$ref": "#/$defs/outputPath"},
        "evidenceBundles": {"$ref": "#/$defs/outputPath"},
        "aggregation": {"$ref": "#/$defs/outputPath"}
      }
    },
    "contentDigest": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?![\\s\\S]*[\\u0000\\u000A\\u000D])(?:[\\s\\S]*\\S)?$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))[^/\\u0000-\\u001F]+(?:/[^/\\u0000-\\u001F]+)*$"
    },
    "projectRootPath": {
      "type": "string",
      "description": "Canonical relative route from the profile directory to its containing project root.",
      "pattern": "^(?:\\.|\\.\\.(?:/\\.\\.)*)$"
    },
    "outputPath": {
      "type": "string",
      "description": "Canonical project-relative path whose segments are portable and safe when quoted into generated Bash or PowerShell commands.",
      "pattern": "^(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9_.+][A-Za-z0-9._+-]*(?:/[A-Za-z0-9_.+][A-Za-z0-9._+-]*)*$"
    },
    "projectPath": {
      "oneOf": [
        {"const": "."},
        {"$ref": "#/$defs/relativePath"}
      ]
    },
    "pathPattern": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[?\\[\\]])[^*/\\u0000-\\u001F]+(?:/[^*/\\u0000-\\u001F]+)*(?:/\\*\\*)?$"
    },
    "executable": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "packageId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "idArray": {
      "type": "array",
      "items": {"$ref": "#/$defs/id"},
      "uniqueItems": true
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "paths", "dependsOn", "quickCaseIds", "typecheckCaseIds"],
      "properties": {
        "id": {"$ref": "#/$defs/packageId"},
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/pathPattern"},
          "uniqueItems": true
        },
        "dependsOn": {
          "type": "array",
          "items": {"$ref": "#/$defs/packageId"},
          "uniqueItems": true
        },
        "quickCaseIds": {"$ref": "#/$defs/idArray"},
        "typecheckCaseIds": {"$ref": "#/$defs/idArray"}
      }
    },
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "paths", "caseIds", "alwaysRun"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "paths": {
          "type": "array",
          "items": {"$ref": "#/$defs/pathPattern"},
          "uniqueItems": true
        },
        "caseIds": {
          "allOf": [
            {"$ref": "#/$defs/idArray"},
            {"minItems": 1}
          ]
        },
        "alwaysRun": {"type": "boolean"}
      }
    },
    "concretePlatform": {
      "enum": ["darwin", "linux", "windows"]
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "required", "shards"],
      "properties": {
        "id": {"$ref": "#/$defs/concretePlatform"},
        "required": {"type": "boolean"},
        "shards": {"type": "integer", "minimum": 1, "maximum": 64}
      }
    }
  }
}
