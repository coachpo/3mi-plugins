{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "steward.platform-evidence-aggregation.v1",
  "title": "Steward Platform Evidence Aggregation v1",
  "description": "Fail-closed aggregation emitted by the closed-loop evidence aggregator. The implementation additionally re-observes profile, CI plan, commit and source identities and compares the exact entry and case partition.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "ok",
    "binding",
    "requiredPlatforms",
    "coveredPlatforms",
    "expectedEntries",
    "coveredEntries",
    "expectedCaseIds",
    "coveredCaseIds",
    "bundleFingerprints",
    "rejectionCodes",
    "errors",
    "aggregationFingerprint"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "steward.platform-evidence-aggregation"},
    "ok": {"type": "boolean"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "sourceFingerprint",
        "profileFingerprint",
        "verificationCatalogFingerprint",
        "ciPlanFingerprint"
      ],
      "properties": {
        "commit": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/objectId"}
          ]
        },
        "sourceFingerprint": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/hash"}
          ]
        },
        "profileFingerprint": {"$ref": "#/$defs/hash"},
        "verificationCatalogFingerprint": {"$ref": "#/$defs/hash"},
        "ciPlanFingerprint": {"$ref": "#/$defs/hash"}
      }
    },
    "requiredPlatforms": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/platform"},
      "uniqueItems": true
    },
    "coveredPlatforms": {
      "type": "array",
      "items": {"$ref": "#/$defs/platform"},
      "uniqueItems": true
    },
    "expectedEntries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/id"},
      "uniqueItems": true
    },
    "coveredEntries": {
      "type": "array",
      "items": {"$ref": "#/$defs/id"},
      "uniqueItems": true
    },
    "expectedCaseIds": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/id"},
      "uniqueItems": true
    },
    "coveredCaseIds": {
      "type": "array",
      "items": {"$ref": "#/$defs/id"}
    },
    "bundleFingerprints": {
      "type": "array",
      "items": {"$ref": "#/$defs/hash"}
    },
    "rejectionCodes": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
      "uniqueItems": true
    },
    "errors": {
      "type": "array",
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "aggregationFingerprint": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {
      "if": {"properties": {"ok": {"const": true}}},
      "then": {
        "properties": {
          "rejectionCodes": {"maxItems": 0},
          "errors": {"maxItems": 0}
        }
      },
      "else": {
        "properties": {
          "rejectionCodes": {"minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?![\\s\\S]*[\\u0000\\u000A\\u000D])(?:[\\s\\S]*\\S)?$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "objectId": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "platform": {
      "enum": ["darwin", "linux", "windows"]
    }
  }
}
